# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# KHAIRUL POS SAAS — PRODUCTION MYSQL 8+ DATABASE CONFIGURATION
# Note: For deployment on your Ubuntu VPS with MySQL 8+.
# During current local prototyping, no live MySQL connection is required.
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khairul_pos_saas
DB_USERNAME=khairul_pos_user
DB_PASSWORD=your_secure_mysql_password_here

# Local Development / Prototyping Fallback (Zero-configuration mode)
# DB_CONNECTION=sqlite
# DB_DATABASE=/database/database.sqlite

# ==============================================================================
# FONNTE WHATSAPP GATEWAY (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
# ==============================================================================
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_API_URL=https://api.fonnte.com/send
